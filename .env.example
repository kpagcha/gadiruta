# Local development only. Copy to .env and replace the key and database password.
# Load explicitly with: uv run --env-file .env python manage.py runserver
DJANGO_SECRET_KEY=replace-this-with-a-random-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=gadiruta
POSTGRES_USER=gadiruta
POSTGRES_PASSWORD=replace-this-with-your-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
